# Desarrollo local; el acceso básico de Docker no necesita este archivo.
DATABASE_URL=postgresql://USUARIO:CLAVE@127.0.0.1:5432/tezcat_workflow
ADMIN_EMAIL=admin@tezcat.local
ADMIN_PASSWORD=

# Docker: puerto publicado; usar otro si 3000 está ocupado. No cambia el puerto interno.
# APP_PORT=3004
# Docker: contraseña inicial de PostgreSQL, al menos 10 caracteres; solo para un volumen nuevo.
# POSTGRES_PASSWORD=

# Opcional: acceso con Google. Sin estas variables funciona correo/contraseña.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/login/google/callback
# En producción HTTPS: ORIGIN=https://workflow.tezcatgroup.com y WORKFLOW_LOCAL_HTTP=false.
